{
  "info": {
    "_postman_id": "swms-bilcode-api-collection",
    "name": "Smart Waste Management System (SWMS) API",
    "description": "Postman Collection resmi untuk pengujian REST API SWMS - Bilcode Technology Take-Home Technical Coding Test (Fullstack Developer)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health & Root",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "API Root Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login Administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set('admin_token', jsonData.access_token);",
                  "    pm.environment.set('token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin@bilcode.id",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Admin123!",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Citizen (Warga)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set('user_token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "user@bilcode.id",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "User123!",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. AI Prediction",
      "item": [
        {
          "name": "Predict Image Classification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/predict",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "predict"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Waste Categories",
      "item": [
        {
          "name": "List Waste Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Waste Reports",
      "item": [
        {
          "name": "Get All Reports (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reports?page=1&limit=10&status=PENDING",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "Create Waste Report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Tumpukan Sampah Botol Plastik di Pinggir Jalan",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Banyak botol plastik menumpuk dekat tiang listrik mengganggu pejalan kaki.",
                  "type": "text"
                },
                {
                  "key": "category_id",
                  "value": "2",
                  "type": "text"
                },
                {
                  "key": "latitude",
                  "value": "-6.2088",
                  "type": "text"
                },
                {
                  "key": "longitude",
                  "value": "106.8456",
                  "type": "text"
                },
                {
                  "key": "address_note",
                  "value": "Jl. Sudirman Kav 21, Jakarta Pusat",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reports",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports"]
            }
          }
        },
        {
          "name": "Get Report Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reports/{{report_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "{{report_id}}"]
            }
          }
        },
        {
          "name": "Update Report Status (Admin Only)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"remarks\": \"Armada kebersihan DLH telah diberangkatkan ke lokasi.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reports/{{report_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reports", "{{report_id}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Dashboard Statistics (Admin Only)",
      "item": [
        {
          "name": "Get Summary Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/dashboard/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "dashboard", "stats"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "user_token",
      "value": ""
    },
    {
      "key": "report_id",
      "value": "1"
    }
  ]
}
