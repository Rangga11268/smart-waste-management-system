    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticate user and obtain JWT token",
        "description": "Authenticate user credentials and return a signed HS256 JWT access token.\n\nSupports both JSON and application/x-www-form-urlencoded payloads.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "admin@bilcode.id"
                  },
                  "password": {
                    "type": "string",
                    "example": "Admin123!"
                  }
                },
                "type": "object",
                "required": [
                  "email",
                  "password"
                ]
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "admin@bilcode.id"
                  },
                  "password": {
                    "type": "string",
                    "example": "Admin123!"
                  }
                },
                "type": "object",
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
