    </linearGradient>
  </defs>
  <!-- Background squircle container -->
  <rect width="64" height="64" rx="16" fill="#F0FDF4"/>
  <rect width="64" height="64" rx="16" fill="none" stroke="#BBF7D0" stroke-width="1.5"/>

  <!-- Centered Botanical 3-Leaf Mark -->
  <g transform="translate(32,32) scale(0.24)">
    <path d="M 0,-104 C 42,-104 84,-72 84,-24 C 84,16 54,48 16,62 C 34,36 38,10 32,-16 C 26,-42 12,-74 0,-104 Z" fill="url(#favLeafA)"/>
