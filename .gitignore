# ==========================================
# SWMS Master Gitignore Configuration
# Smart Waste Management System (SWMS)
# ==========================================

# ------------------------------------------
# Byte-compiled / Python Cache
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ------------------------------------------
# Virtual Environments
# ------------------------------------------
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------
# Python Testing, Caching & Coverage
# ------------------------------------------
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.mypy_cache/
.ruff_cache/
.hypothesis/

# ------------------------------------------
# Python Packaging & Distribution
# ------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# Node.js / Next.js Web App
# ------------------------------------------
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------
# Flutter / Dart Mobile App
# ------------------------------------------
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
mobile/build/
ephemeral/
*.apk
*.aab
*.iml
.metadata

# Whitelist release APKs stored in documentation
!docs/**/*.apk

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# Databases (Local Development Fallbacks)
# ------------------------------------------
*.db
*.sqlite
*.sqlite3

# ------------------------------------------
# IDEs, Editors & Workspaces
# ------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# Operating System Garbage
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# Static Media Uploads (Preserve structure)
# ------------------------------------------
backend/uploads/*
!backend/uploads/.gitkeep

# ------------------------------------------
# ML Checkpoints & Models
# ------------------------------------------
ml_pipeline/checkpoints/
*.ckpt

# Explicitly whitelist core library directories & production models
!mobile/lib/
!mobile/lib/**
!web/src/lib/
!web/src/lib/**
!waste_model.pth
!ml_pipeline/saved_models/waste_model.pth
